# Copie para backend/.env e ajuste se necessário. Todos os valores abaixo são os padrões.

DATABASE_URL=sqlite:///./financas.db

# ollama (local, gratuito) | anthropic (Claude, pago) | none (só memória + regras)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Só necessário com LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5-5
